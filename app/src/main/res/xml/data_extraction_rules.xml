<?xml version="1.0" encoding="utf-8"?>
<!--
  系统备份与换机迁移只留偏好设置（备份每个应用有 25 MB 上限，超了整份都不备份）：
  - 令牌文件及写入临时文件：令牌与网页 Cookie 不带到新机上（Cookie 的 Keystore 密钥不随备份走，恢复回来也解不开）；
    DataStore 先写同目录的 .tmp 再替换正式文件，写入中进程被杀可能留下临时文件；
  - 数据库：按账号分的缓存都能重拉，恢复到登出状态的新机上不该带回上一个账号的内容；草稿、屏蔽的小组、
    搜索预设也在这个库里，同样不随备份走；
  - 表情缓存、调试包的崩溃记录：能重拉，或只在本机有意义；
  - WebView 存储：人机验证留下的 Cookie。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/chogumi_tokens.preferences_pb" />
        <exclude domain="file" path="datastore/chogumi_tokens.preferences_pb.tmp" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="bangumi_smiley/" />
        <exclude domain="file" path="crash/" />
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/chogumi_tokens.preferences_pb" />
        <exclude domain="file" path="datastore/chogumi_tokens.preferences_pb.tmp" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="bangumi_smiley/" />
        <exclude domain="file" path="crash/" />
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
